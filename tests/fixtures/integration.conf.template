server {
    listen @HTTP_PORT@;
    server_name integration.test;

    location / {
        default_type text/plain;
        content_by_lua_block {
            ngx.say("ok")
        }
    }
}

server {
    listen @TLS_PORT@ ssl;
    server_name integration.test;

    ssl_certificate /config/keys/cert.crt;
    ssl_certificate_key /config/keys/cert.key;
    include /config/nginx/snippets/hsts.conf;

    location / {
        default_type text/plain;
        content_by_lua_block {
            ngx.say("@TLS_BODY@")
        }
    }
}
