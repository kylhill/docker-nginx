{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "dockerfile",
    "github-actions",
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update pinned Alpine packages in the Dockerfile",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>apk) depName=(?<depName>[^\\s]+)\\nARG [A-Z0-9_]+_VERSION=(?<currentValue>[^\\s]+)"
      ],
      "registryUrlTemplate": "https://dl-cdn.alpinelinux.org/alpine?branch=latest-stable&components=main,community&arch=x86_64"
    },
    {
      "customType": "regex",
      "description": "Update the CrowdSec bouncer release and archive checksum",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=github-release-attachments depName=crowdsecurity/cs-nginx-bouncer\\nARG CROWDSEC_BOUNCER_VERSION=(?<currentValue>[^\\s]+)\\nARG CROWDSEC_BOUNCER_SHA256=(?<currentDigest>[a-f0-9]{64})"
      ],
      "datasourceTemplate": "github-release-attachments",
      "depNameTemplate": "crowdsecurity/cs-nginx-bouncer",
      "currentValueTemplate": "v{{{currentValue}}}",
      "autoReplaceStringTemplate": "# renovate: datasource=github-release-attachments depName=crowdsecurity/cs-nginx-bouncer\nARG CROWDSEC_BOUNCER_VERSION={{replace '^v' '' newValue}}\nARG CROWDSEC_BOUNCER_SHA256={{#if newDigest}}{{{newDigest}}}{{else}}{{{currentDigest}}}{{/if}}",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update the Forgejo job to the newest Node.js LTS major",
      "managerFilePatterns": [
        "/^\\.forgejo/workflows/(docker-publish|pull-request)\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=node-version depName=node\\n\\s+image: docker\\.io/library/node:(?<currentValue>\\d+)-alpine"
      ],
      "datasourceTemplate": "node-version",
      "depNameTemplate": "node",
      "extractVersionTemplate": "^v?(?<version>\\d+)",
      "versioningTemplate": "node"
    },
    {
      "customType": "regex",
      "description": "Update pinned CI helper images",
      "managerFilePatterns": [
        "/^\\.(forgejo|github)/workflows/(docker-publish|pull-request)\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>docker) depName=(?<depName>[^\\s]+)\\n\\s+[A-Z0-9_]+_IMAGE: docker\\.io/[^\\s:]+(?:/[^\\s:]+)*:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ]
    }
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "apk"
      ],
      "groupName": "Alpine base and packages"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/(^|\\/)alpine$/"
      ],
      "groupName": "Alpine base and packages"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchDepTypes": [
        "container"
      ],
      "pinDigests": true
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/(^|\\/)node$/"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ],
  "automerge": false,
  "dependencyDashboard": false,
  "prConcurrentLimit": 3
}
