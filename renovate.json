{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "group:allDigest"
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "branchConcurrentLimit": 0,
  "enabledManagers": [
    "dockerfile",
    "github-actions",
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the separately downloaded lua-resty-string APK",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=apk depName=(?<depName>lua-resty-string)\\nARG LUA_RESTY_STRING_VERSION=(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "apk",
      "depTypeTemplate": "apk"
    },
    {
      "customType": "regex",
      "description": "Update the CrowdSec bouncer release and archive checksum",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=github-release-attachments depName=crowdsecurity/cs-nginx-bouncer\\nARG CROWDSEC_BOUNCER_VERSION=(?<currentValue>[^\\s]+)\\nARG CROWDSEC_BOUNCER_SHA256=(?<currentDigest>[a-f0-9]{64})"
      ],
      "datasourceTemplate": "github-release-attachments",
      "depNameTemplate": "crowdsecurity/cs-nginx-bouncer",
      "currentValueTemplate": "v{{{currentValue}}}",
      "autoReplaceStringTemplate": "# renovate: datasource=github-release-attachments depName=crowdsecurity/cs-nginx-bouncer\nARG CROWDSEC_BOUNCER_VERSION={{replace '^v' '' newValue}}\nARG CROWDSEC_BOUNCER_SHA256={{{newDigest}}}",
      "versioningTemplate": "semver",
      "depTypeTemplate": "bouncer"
    },
    {
      "customType": "regex",
      "description": "Update pinned CI helper images",
      "managerFilePatterns": [
        "/^\\.(forgejo|github)/workflows/(docker-publish|pull-request)\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>docker) depName=(?<depName>[^\\s]+)\\n\\s+[A-Z0-9_]+_IMAGE: docker\\.io/[^\\s:]+(?:/[^\\s:]+)*:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "versioningTemplate": "docker",
      "depTypeTemplate": "container"
    }
  ],
  "packageRules": [
    {
      "description": "Look up APK versions in the Alpine base branch; update this URL with base-branch upgrades",
      "matchDatasources": [
        "apk"
      ],
      "registryUrls": [
        "https://dl-cdn.alpinelinux.org/alpine?branch=v3.24&components=main,community&arch=x86_64"
      ],
      "commitMessageTopic": "Alpine package {{depName}}"
    },
    {
      "description": "Keep the Alpine base and all APK pins compatible on both architectures",
      "matchDatasources": [
        "docker",
        "apk"
      ],
      "matchPackageNames": [
        "docker.io/library/alpine",
        "alpine",
        "curl",
        "lua-resty-http",
        "lua-resty-openssl",
        "lua-resty-string",
        "lua5.1-cjson",
        "nginx",
        "nginx-mod-http-brotli",
        "nginx-mod-http-geoip2",
        "nginx-mod-http-lua",
        "nginx-mod-http-zstd",
        "tzdata",
        "patch"
      ],
      "groupName": "Alpine runtime dependencies",
      "groupSlug": "alpine-runtime",
      "separateMajorMinor": false
    },
    {
      "description": "Describe image updates consistently across native and custom extraction",
      "matchDatasources": [
        "docker"
      ],
      "commitMessageTopic": "container {{depName}}",
      "prBodyDefinitions": {
        "Type": "container"
      }
    },
    {
      "matchDatasources": [
        "github-release-attachments"
      ],
      "matchPackageNames": [
        "crowdsecurity/cs-nginx-bouncer"
      ],
      "commitMessageTopic": "CrowdSec nginx bouncer"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchDepTypes": [
        "action"
      ],
      "commitMessageTopic": "CI action {{depName}}"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchDepTypes": [
        "workflow"
      ],
      "commitMessageTopic": "CI workflow {{depName}}"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "matchPackageNames": [
        "docker.io/renovate/renovate"
      ],
      "changelogUrl": "https://github.com/renovatebot/renovate/releases"
    }
  ]
}
